# Copy this file to `.env` (which is gitignored) and fill in real values.
# Docker Compose reads `.env` automatically from this directory.
#
# NOTE: the Spring app also needs CRM_DB_PASSWORD to resolve the ${CRM_DB_PASSWORD}
# placeholder in application.properties. Set it in your IntelliJ run config
# (Environment variables) with the SAME value you put here.

CRM_DB_PASSWORD=change-me-app-user-password
CRM_DB_ROOT_PASSWORD=change-me-root-password
